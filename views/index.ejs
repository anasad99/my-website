<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Anas El Aadil — Graphic Designer</title>
<meta name="description" content="Anas El Aadil is a multidisciplinary graphic designer specializing in brand identity, packaging and editorial design.">
<link rel="stylesheet" href="/styles.css">
<link rel="icon" href="/assets/A.png">
</head>
<body>

<a class="skip-link" href="#main">Skip to content</a>

<%- include('partials/nav', { active: 'work' }) %>

<main id="main">

  <section class="hero section">
    <div class="hero__frame">
      <img src="/assets/hero.png" alt="Portrait of Anas El Aadil" width="363" height="360">
    </div>
  </section>

  <section class="intro section">
    <div class="intro__content">
      <h1 class="intro__text">Anas El Aadil is a multidisciplinary graphic designer specializing in brand identity, packaging and editorial design, five years translating brand strategy into considered visual work across digital and print.</h1>
    </div>
  </section>

  <section class="work section" id="work">
    <h2 class="work__label">Our work</h2>

    <% projects.forEach(function (project) { %>
    <article class="project inset">
      <div class="strip" tabindex="0" role="group" aria-label="<%= project.name %> project images">
        <ul class="strip__track">
          <% var stripImages = project.images.slice(0, 3); %>
          <% stripImages.forEach(function (image) { %>
          <li><img src="/<%= image.src %>" alt="<%= image.alt %>" width="461" height="446"></li>
          <% }) %>
          <% stripImages.forEach(function (image) { %>
          <li aria-hidden="true"><img src="/<%= image.src %>" alt="" width="461" height="446"></li>
          <% }) %>
        </ul>
      </div>

      <div class="project__meta">
        <div class="project__title">
          <span class="project__eyebrow">Project</span>
          <span class="project__names">
            <span class="project__name"><%= project.name %></span>
            <span class="project__discipline"><%= project.discipline %></span>
          </span>
        </div>
        <div class="project__body">
          <p><%= project.lead %></p>
          <a class="text-link" href="/project/<%= project.slug %>">See Project <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
    </article>
    <% }) %>
  </section>

  <section class="connect section">
    <div class="connect__content inset">
      <hr class="rule">
      <p class="connect__text">Connect with us to explore your project&rsquo;s potential.</p>
      <hr class="rule">
    </div>
  </section>

</main>

<%- include('partials/footer') %>

<script src="/nav.js"></script>

</body>
</html>
