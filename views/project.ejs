<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= project.name %> — Anas El Aadil</title>
<meta name="description" content="<%= project.lead.slice(0, 150) %>">
<link rel="stylesheet" href="/styles.css">
<link rel="icon" href="/assets/A.png">
</head>
<body>

<a class="skip-link" href="#main">Skip to content</a>

<%- include('partials/nav', { active: 'work' }) %>

<div class="masthead section">
  <img src="/assets/masthead-aea.svg" alt="A.E.A" width="324" height="96">
</div>

<main id="main">

  <section class="case-head section">
    <div class="case-head__inner">
      <div class="case-head__title">
        <a class="case-head__kicker" href="#main">Case Study</a>
        <h1 class="case-head__name"><%= project.name %></h1>
      </div>

      <div class="case-head__body">
        <p class="case-head__lead"><%= project.lead %></p>
        <ul class="case-head__services">
          <% project.services.forEach(function (service) { %>
          <li><%= service %></li>
          <% }) %>
        </ul>
      </div>
    </div>
  </section>

  <section class="case-media section" aria-label="Project imagery">
    <% layout.forEach(function (group) { %>
      <% if (group.type === 'wide') { %>
        <img class="media-wide" src="/<%= group.images[0].src %>" alt="<%= group.images[0].alt %>" width="1250" height="590">
      <% } else { %>
        <div class="media-pair">
          <img src="/<%= group.images[0].src %>" alt="<%= group.images[0].alt %>" width="618" height="590">
          <img src="/<%= group.images[1].src %>" alt="<%= group.images[1].alt %>" width="618" height="590">
        </div>
      <% } %>
    <% }) %>
  </section>

  <% if (otherProjects.length) { %>
  <section class="others section">
    <div class="others__head">
      <hr class="rule">
      <h2 class="others__title">Other Projects</h2>
    </div>

    <ul class="others__grid">
      <% otherProjects.forEach(function (other) { %>
      <li class="others__card">
        <a href="/project/<%= other.slug %>"><img src="/<%= other.images[0].src %>" alt="<%= other.images[0].alt %>" width="407" height="389"></a>
        <a class="text-link" href="/project/<%= other.slug %>">See Project <span aria-hidden="true">&rarr;</span></a>
      </li>
      <% }) %>
    </ul>
  </section>
  <% } %>

  <section class="connect connect--flush section">
    <div class="connect__content">
      <hr class="rule">
      <p class="connect__text">Connect with us to explore your project&rsquo;s potential.</p>
      <hr class="rule">
    </div>
  </section>

</main>

<%- include('partials/footer') %>

<script src="/nav.js"></script>
</body>
</html>
