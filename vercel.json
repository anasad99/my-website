{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "views/**",
          "assets/**",
          "data/**",
          "styles.css",
          "nav.js",
          "contact.js",
          "others-carousel.js",
          "admin-upload.js",
          "about.html",
          "contact.html"
        ]
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "server.js" }]
}
