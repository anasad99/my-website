# Copy to .env and fill in real values before deploying.
# Never commit real secrets here — this file is tracked by git.

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=replace-with-a-long-random-string

PORT=3000


SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=anasadacc@gmail.com


# Persistent storage for Vercel (or any host without a real writable disk).
# Without these, added works/messages are saved to a local JSON file and
# uploaded images to local disk — fine for local dev, but on Vercel that
# storage resets on every redeploy/cold start.
#
# Both are free for a site this size:
#
# 1. Vercel dashboard -> your project -> Storage tab -> Create Database ->
#    pick "Upstash" (Redis) from Marketplace Database Providers -> connect
#    it to this project. Vercel injects KV_REST_API_URL / KV_REST_API_TOKEN
#    automatically — you don't need to set them here unless testing locally
#    against the same database (copy them from the Upstash dashboard).
KV_REST_API_URL=
KV_REST_API_TOKEN=
#
# 2. Storage tab -> Create Database -> Blob -> connect it to this project.
#    Same deal: Vercel injects BLOB_READ_WRITE_TOKEN automatically.
BLOB_READ_WRITE_TOKEN=
